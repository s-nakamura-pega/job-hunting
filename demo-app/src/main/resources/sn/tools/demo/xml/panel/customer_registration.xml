<?xml version="1.0" encoding="UTF-8"?>
<screen>
	<border-panel>
		<north>
			<label h-align="center" font-size="16">Customer Registration</label>
		</north>
		<center>
			<flow-panel baseline="true" vgap="50">
			<grid-panel cols="2" rows="3" vgap="10" hgap="20">
				<label h-align="right" font-style="BOLD">Customer</label>
				<text id="name" width="300"></text>
				<label h-align="right" font-style="BOLD">Address</label>
				<text id="address" width="300"></text>
				<label h-align="right" font-style="BOLD">TEL</label>
				<text id="tel" width="300"></text>
			</grid-panel>
			</flow-panel>
		</center>
		<south>
			<flow-panel >
				<button id="register" align="center">Registration</button>
			</flow-panel>
		</south>
	</border-panel>
</screen>