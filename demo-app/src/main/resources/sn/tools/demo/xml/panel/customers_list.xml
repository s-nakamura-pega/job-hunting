<?xml version="1.0" encoding="UTF-8"?>
<screen>
	<border-panel>
		<north>
			<label h-align="center" font-size="16">Search Results</label>
		</north>
		<center>
			<scroll>
				<table id="list">
					<column>ID</column>
					<column>Customer</column>
					<column>Address</column>
					<column>TEL</column>
				</table>
			</scroll>
		</center>
		<south>
			<flow-panel >
				<button id="back" align="center">Return to Search</button>
			</flow-panel>
		</south>
	</border-panel>
</screen>